{
  "expo": {
    "name": "XR Feed",
    "slug": "xrfeed",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/XRFeed.png",
    "scheme": "xrfeed",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/XRFeed.icon",
      "bundleIdentifier": "com.justinstorm1.XRFeed",
      "supportsTablet": true,
      "appleTeamId": "5F6867XG3V",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/XRFeed.png",
      "adaptiveIcon": {
        "backgroundColor": "#002AFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.justinstorm1.XRFeed"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/XRFeed.png",
          "imageWidth": 140,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/XRFeed.png"
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bdaf1498-ddea-4908-a235-0019af30bf97"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bdaf1498-ddea-4908-a235-0019af30bf97"
    }
  }
}
